{
  "name": "sunagent15",
  "version": "2.53.3",
  "description": "Unified Development System - World-class system development platform with OpenCode/OMO integration and Workflow Guardian",
  "main": "src/index.js",
  "scripts": {
    "setup": "bash scripts/install.sh",
    "setup:fresh": "bash scripts/install.sh --fresh",
    "uninstall:taisun": "bash scripts/uninstall.sh",
    "update": "bash scripts/update.sh",
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand",
    "test:silent": "jest --silent --noStackTrace",
    "test:summary": "jest --verbose=false --noStackTrace 2>&1 | tail -20",
    "test:unit": "jest --selectProjects unit",
    "test:workflow-phase3": "jest --selectProjects workflow-phase3 --runInBand",
    "test:integration": "jest --selectProjects integration",
    "test:agents": "jest --selectProjects integration --testPathPattern=agents.integration",
    "test:skills": "jest --selectProjects integration --testPathPattern=skills.integration",
    "test:mcp": "jest --selectProjects integration --testPathPattern=mcp.integration",
    "test:memory": "jest --selectProjects integration --testPathPattern=memory.integration",
    "test:performance": "jest --selectProjects integration --testPathPattern=performance.integration",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:guards": "jest --testPathPattern=workflow-fidelity-guard --runInBand",
    "workflow:lint": "node .claude/hooks/definition-lint-gate.js lint-all",
    "guard:verify": "npm run workflow:lint && npm run test:guards",
    "check:unicode": "node scripts/check-hidden-unicode.js",
    "context:report": "node scripts/context-footprint.js",
    "context:report:hooks": "node scripts/context-footprint.js --hooks",
    "context:check": "node scripts/context-footprint.js --check --limit 3800",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "typecheck": "tsc --noEmit",
    "security:scan": "trivy fs --severity HIGH,CRITICAL .",
    "docs:generate": "typedoc src/",
    "memory:update": "node scripts/update-memory-stats.js",
    "memory:report": "npx ts-node scripts/memory-report.ts",
    "memory:report:summary": "npx ts-node scripts/memory-report.ts summary",
    "memory:report:detailed": "npx ts-node scripts/memory-report.ts detailed",
    "memory:report:trends": "npx ts-node scripts/memory-report.ts trends",
    "memory:report:errors": "npx ts-node scripts/memory-report.ts errors",
    "memory:export": "npx ts-node scripts/memory-report.ts export",
    "memory:backup": "npx ts-node scripts/memory-report.ts backup",
    "perf:report": "npx ts-node scripts/performance-report.ts",
    "perf:metrics": "npx ts-node scripts/performance-report.ts metrics",
    "perf:recommend": "npx ts-node scripts/performance-report.ts recommend",
    "perf:benchmark": "npx ts-node scripts/run-benchmarks.ts",
    "mcp:dev": "node .claude/scripts/switch-mcp-profile.js development",
    "mcp:secure": "node .claude/scripts/switch-mcp-profile.js secure",
    "mcp:marketing": "node .claude/scripts/switch-mcp-profile.js marketing",
    "mcp:status": "node .claude/scripts/switch-mcp-profile.js --status",
    "perf:benchmark:json": "npx ts-node scripts/run-benchmarks.ts --format=json --output=benchmark-results.json",
    "agents:list": "node scripts/list-agents.js",
    "skills:list": "node scripts/list-skills.js",
    "audit:metadata": "node scripts/audit-project-metadata.js",
    "audit:metadata:json": "node scripts/audit-project-metadata.js --json",
    "sync:plugin-metadata": "node scripts/sync-plugin-metadata.js --write",
    "sync:plugin-metadata:check": "node scripts/sync-plugin-metadata.js --check",
    "postinstall": "npm run build:all",
    "build:all": "npm run proxy:build && npm run scripts:build",
    "build:windows": "npm run proxy:build & npm run scripts:build",
    "proxy:start": "npx ts-node src/proxy-mcp/server.ts",
    "proxy:build": "tsc --project tsconfig.proxy.json",
    "scripts:build": "tsc --project tsconfig.scripts.json",
    "proxy:smoke": "node scripts/proxy-smoke.js",
    "internal-mcp:rollout": "node dist/proxy-mcp/internal/rollout-cli.js",
    "obs:report:daily": "node dist/proxy-mcp/observability/report-cli.js --period 24h",
    "obs:report:weekly": "node dist/proxy-mcp/observability/report-cli.js --period 7d",
    "obs:post:daily": "node dist/proxy-mcp/observability/report-cli.js --period 24h --post",
    "obs:post:weekly": "node dist/proxy-mcp/observability/report-cli.js --period 7d --post",
    "chrome:debug:start": "node dist/proxy-mcp/browser/cdp/chrome-debug-cli.js",
    "chrome:cdp:smoke": "node dist/proxy-mcp/browser/cdp/cdp-smoke-cli.js",
    "ops:schedule:run": "node dist/scripts/ops/schedule-runner.js",
    "ops:schedule:loop": "node dist/scripts/ops/schedule-runner.js --loop",
    "ops:schedule:status": "node dist/scripts/ops/schedule-runner.js --status",
    "security:secrets-scan": "npx gitleaks detect --source . --verbose",
    "doctor": "npx ts-node src/utils/env-check.ts",
    "workflow:start": "npx tsx scripts/workflow/start.ts",
    "workflow:status": "npx tsx scripts/workflow/status.ts",
    "workflow:next": "npx tsx scripts/workflow/next.ts",
    "workflow:verify": "npx tsx scripts/workflow/verify.ts",
    "workflow:rollback": "npx tsx scripts/workflow/rollback.ts",
    "briefing": "npx ts-node scripts/session-briefing.ts",
    "briefing:sync": "npx ts-node scripts/session-briefing.ts --sync",
    "contract:lint": "npx ts-node scripts/contract-lint.ts",
    "mistake:testgen": "npx ts-node scripts/mistake-to-test.ts",
    "text:safe-replace": "npx ts-node scripts/text/safe-replace.ts",
    "text:utf8-guard": "npx ts-node scripts/text/utf8-guard.ts",
    "quality:encoding": "npx ts-node scripts/text/utf8-guard.ts",
    "quality:check": "npm run contract:lint && npm run quality:encoding && npm test",
    "mcp:health": "node scripts/mcp-health-check.js",
    "setup:windows": "node scripts/setup-windows.js",
    "perf:fast": "node scripts/switch-performance-mode.js fast",
    "perf:normal": "node scripts/switch-performance-mode.js normal",
    "perf:strict": "node scripts/switch-performance-mode.js strict",
    "perf:status": "node scripts/switch-performance-mode.js status",
    "taisun:version": "node scripts/taisun-version.js",
    "taisun:verify": "node scripts/verify-installation.js",
    "taisun:support": "node scripts/taisun-support.js",
    "taisun:diagnose": "node scripts/taisun-diagnose.js",
    "taisun:diagnose:full": "node scripts/taisun-diagnose.js --full",
    "taisun:diagnose:fix": "node scripts/taisun-diagnose.js --fix",
    "taisun:explain": "node .claude/skills/guide/explain/cli.js explain",
    "taisun:guide": "node .claude/skills/guide/explain/cli.js guide",
    "taisun:hint:on": "node .claude/skills/guide/explain/cli.js hint on",
    "taisun:hint:off": "node .claude/skills/guide/explain/cli.js hint off",
    "taisun:setup": "npm install && npm run build:all && node -e \"try{require('child_process').execSync('chmod +x .claude/hooks/*.js')}catch(e){}\" && node -e \"const fs=require('fs');if(!fs.existsSync('.mcp.json')&&fs.existsSync('.mcp.json.example')){fs.copyFileSync('.mcp.json.example','.mcp.json');console.log('[OK] .mcp.json created from .mcp.json.example');}else if(fs.existsSync('.mcp.json')){console.log('[OK] .mcp.json already exists');}\" && npm run taisun:diagnose",
    "metrics:collect": "node .claude/hooks/metrics-collector.js",
    "metrics:aggregate": "node .claude/hooks/metrics-aggregator.js",
    "metrics:report": "node .claude/hooks/generate-metrics-report.js",
    "metrics:report:7d": "node .claude/hooks/generate-metrics-report.js --days=7",
    "metrics:report:30d": "node .claude/hooks/generate-metrics-report.js --days=30"
  },
  "keywords": [
    "ai",
    "agents",
    "development",
    "automation",
    "claude",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@prisma/client": "^7.5.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "kuromoji": "^0.1.2",
    "proper-lockfile": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^20.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.7",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "playwright-core": "^1.57.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typedoc": "^0.25.4",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
