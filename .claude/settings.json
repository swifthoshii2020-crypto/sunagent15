{
  "alwaysThinkingEnabled": true,
  "disabledMcpServers": [
    "figma",
    "qdrant",
    "chroma",
    "n8n-mcp",
    "meta-ads",
    "facebook-ads-library",
    "mcp-memory-service",
    "sequential-thinking",
    "pexels",
    "obsidian",
    "puppeteer",
    "gpt-researcher"
  ],
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Task",
      "WebFetch",
      "WebSearch",
      "AskUserQuestion"
    ],
    "deny": []
  },
  "preferredModel": "sonnet",
  "mcpServers": {
    "codebase-memory": {
      "type": "stdio",
      "command": "./tools/codebase-memory-mcp/codebase-memory-mcp",
      "args": [],
      "disabled": false,
      "defer_loading": true,
      "search_keywords": [
        "codegraph",
        "コードグラフ",
        "依存関係",
        "影響分析",
        "コード検索",
        "関数呼び出し",
        "code search",
        "dependency",
        "impact"
      ],
      "description": "CodeGraph - コードベース知識グラフ検索・影響分析（64言語対応）",
      "category": "code-intelligence"
    }
  },
  "maxParallelAgents": 5,
  "qualityGates": {
    "codeReviewMinScore": 80,
    "testCoverageMin": 80,
    "securityScanRequired": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/workflow-sessionstart-injector.js ] && exit 0; node .claude/hooks/workflow-sessionstart-injector.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/codegraph-oss-monitor.js ] && exit 0; node .claude/hooks/codegraph-oss-monitor.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/context-snapshot-manager.js ] && exit 0; node .claude/hooks/context-snapshot-manager.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/context-snapshot-manager.js ] && exit 0; node .claude/hooks/context-snapshot-manager.js",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/model-auto-switch.js ] && exit 0; node .claude/hooks/model-auto-switch.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/skill-usage-guard.js ] && exit 0; node .claude/hooks/skill-usage-guard.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/mid-session-reminder.js ] && exit 0; node .claude/hooks/mid-session-reminder.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/agent-enforcement-guard.js ] && exit 0; node .claude/hooks/agent-enforcement-guard.js",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/unified-guard.js ] && exit 0; node .claude/hooks/unified-guard.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/deviation-approval-guard.js ] && exit 0; node .claude/hooks/deviation-approval-guard.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|Task",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/agent-enforcement-guard.js ] && exit 0; node .claude/hooks/agent-enforcement-guard.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/checkpoint-guard.js ] && exit 0; node .claude/hooks/checkpoint-guard.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/agent-checkpoint-guard.js ] && exit 0; node .claude/hooks/agent-checkpoint-guard.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|Task|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/rules-enforce-guard.js ] && exit 0; node .claude/hooks/rules-enforce-guard.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/research-quality-guard.js ] && exit 0; node .claude/hooks/research-quality-guard.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|Task|MultiEdit|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/cost-hard-stop-guard.js ] && exit 0; node .claude/hooks/cost-hard-stop-guard.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|Task|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/mistake-pattern-matcher.js ] && exit 0; node .claude/hooks/mistake-pattern-matcher.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/pre-compact-save.js ] && exit 0; node .claude/hooks/pre-compact-save.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/error-explain-hook.js"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/rules-read-tracker.js ] && exit 0; node .claude/hooks/rules-read-tracker.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/auto-adr.js ] && exit 0; node .claude/hooks/auto-adr.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/definition-lint-gate.js ] && exit 0; node .claude/hooks/definition-lint-gate.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/agent-trace-capture.js ] && exit 0; node .claude/hooks/agent-trace-capture.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/compact-optimizer.js ] && exit 0; node .claude/hooks/compact-optimizer.js",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/task-overflow-guard.js ] && exit 0; node .claude/hooks/task-overflow-guard.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/agent-usage-logger.js ] && exit 0; node .claude/hooks/agent-usage-logger.js",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/output-verifier.js ] && exit 0; node .claude/hooks/output-verifier.js",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/codegraph-roi-meter.js ] && exit 0; node .claude/hooks/codegraph-roi-meter.js",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/codegraph-auto-index.js ] && exit 0; node .claude/hooks/codegraph-auto-index.js",
            "timeout": 12
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/context-snapshot-manager.js ] && exit 0; node .claude/hooks/context-snapshot-manager.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/session-handoff-generator.js ] && exit 0; node .claude/hooks/session-handoff-generator.js",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f .claude/hooks/stop-failure-logger.js ] && exit 0; node .claude/hooks/stop-failure-logger.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
